[
  {
    "id": "us-pay-gap-job",
    "mode": "us",
    "topic": "money",
    "title": "Pay gap in your job",
    "question": "How do women and men in your job compare?",
    "kind": "item_record",
    "datasets": [
      "us.acs.occ_pay_gap"
    ],
    "inputs": [
      {
        "key": "occupation",
        "type": "select",
        "label": "Occupation",
        "optionsFrom": {
          "dataset": "us.acs.occ_pay_gap",
          "path": [
            "occupations"
          ]
        },
        "default": "1021"
      }
    ],
    "params": {
      "dataset": "us.acs.occ_pay_gap",
      "items": {
        "o": {
          "path": [
            "occupations",
            "{occupation}"
          ]
        },
        "all": {
          "path": [
            "all"
          ]
        }
      },
      "error": "There are no figures for that occupation yet.",
      "values": {
        "cents": {
          "ratio": [
            "o.F",
            "o.M"
          ],
          "scale": 100,
          "format": {
            "type": "int"
          }
        },
        "job": {
          "field": "o.label",
          "format": {
            "type": "text",
            "case": "lower"
          }
        },
        "women": {
          "field": "o.F",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        },
        "men": {
          "field": "o.M",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        },
        "allCents": {
          "ratio": [
            "all.F",
            "all.M"
          ],
          "scale": 100,
          "format": {
            "type": "int"
          }
        }
      }
    },
    "text": {
      "headline": "{cents}¢ per $1",
      "sentence": "Women working full time as {job} earn a median {women}, against {men} for men.",
      "stats": [
        [
          "Across all occupations",
          "{allCents}¢ per $1"
        ]
      ],
      "caveats": [
        "Medians for full-time workers; the gap also reflects differences in hours, experience and specialty."
      ]
    }
  },
  {
    "id": "us-job-outlook",
    "mode": "us",
    "topic": "money",
    "title": "Job outlook",
    "question": "Is your occupation projected to grow?",
    "kind": "item_record",
    "datasets": [
      "us.bls.projections"
    ],
    "inputs": [
      {
        "key": "occupation",
        "type": "select",
        "label": "Occupation",
        "optionsFrom": {
          "dataset": "us.bls.projections",
          "path": [
            "occupations"
          ],
          "labelField": "title"
        },
        "default": null
      }
    ],
    "params": {
      "dataset": "us.bls.projections",
      "items": {
        "o": {
          "path": [
            "occupations",
            "{occupation}"
          ]
        },
        "d": {
          "path": []
        }
      },
      "error": "There are no projections for that occupation yet.",
      "values": {
        "change": {
          "field": "o.change",
          "format": {
            "type": "change"
          }
        },
        "job": {
          "field": "o.title",
          "format": {
            "type": "text",
            "case": "lower"
          }
        },
        "verb": {
          "field": "o.change",
          "atLeast": 0,
          "then": "grow",
          "else": "shrink"
        },
        "size": {
          "field": "o.change",
          "abs": true,
          "format": {
            "type": "pct",
            "digits": 1
          }
        },
        "baseYear": {
          "field": "d.baseYear"
        },
        "projYear": {
          "field": "d.projYear"
        },
        "allChange": {
          "field": "d.all.change",
          "format": {
            "type": "change"
          }
        },
        "baseJobs": {
          "field": "o.base",
          "format": {
            "type": "compact"
          }
        },
        "projJobs": {
          "field": "o.proj",
          "format": {
            "type": "compact"
          }
        }
      }
    },
    "text": {
      "headline": "{change}",
      "sentence": "Jobs as {job} are projected to {verb} {size} from {baseYear} to {projYear}, against {allChange} for all jobs.",
      "stats": [
        [
          "Jobs in {baseYear}",
          "{baseJobs}"
        ],
        [
          "Jobs in {projYear}",
          "{projJobs}"
        ]
      ]
    }
  },
  {
    "id": "us-ai-exposure",
    "mode": "us",
    "topic": "money",
    "title": "AI exposure of your job",
    "question": "Which of your job’s tasks do people already do with AI?",
    "kind": "item_record",
    "datasets": [
      "us.aei.tasks"
    ],
    "inputs": [
      {
        "key": "occupation",
        "type": "select",
        "label": "Occupation",
        "optionsFrom": {
          "dataset": "us.aei.tasks",
          "path": [
            "occupations"
          ],
          "labelField": "title"
        },
        "default": null
      }
    ],
    "params": {
      "dataset": "us.aei.tasks",
      "items": {
        "o": {
          "path": [
            "occupations",
            "{occupation}"
          ]
        }
      },
      "error": "There are no figures for that occupation yet.",
      "values": {
        "share": {
          "field": "o.taskShare",
          "format": {
            "type": "pct"
          }
        },
        "job": {
          "field": "o.title",
          "format": {
            "type": "text",
            "case": "lower"
          }
        }
      },
      "grid": {
        "share": "share"
      },
      "bars": {
        "title": "Most common tasks",
        "list": "o.tasks",
        "limit": 5,
        "unit": "share"
      }
    },
    "text": {
      "headline": "{share}",
      "sentence": "{share} of the tasks listed for {job} show up in the Anthropic Economic Index, which tracks how people use Claude.",
      "caveats": [
        "Shows where AI is used today, not whether a job will be replaced."
      ]
    }
  },
  {
    "id": "us-degree-earns",
    "mode": "us",
    "topic": "education",
    "title": "What your degree earns",
    "question": "What do people with your degree earn?",
    "kind": "item_record",
    "datasets": [
      "us.acs.degree_earnings"
    ],
    "inputs": [
      {
        "key": "field",
        "type": "select",
        "label": "Field of your degree",
        "optionsFrom": {
          "dataset": "us.acs.degree_earnings",
          "path": [
            "fields"
          ]
        },
        "default": null
      }
    ],
    "params": {
      "dataset": "us.acs.degree_earnings",
      "items": {
        "f": {
          "path": [
            "fields",
            "{field}"
          ]
        },
        "all": {
          "path": [
            "overall"
          ]
        }
      },
      "error": "There are no figures for that field yet.",
      "values": {
        "median": {
          "field": "f.median",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        },
        "label": {
          "field": "f.label"
        },
        "overall": {
          "field": "all.median",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        },
        "p25": {
          "field": "f.p25",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        },
        "p75": {
          "field": "f.p75",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        }
      }
    },
    "text": {
      "headline": "{median}",
      "sentence": "Full-time workers aged 25 to 64 with a degree in {label} earn a median {median} a year, against {overall} across all fields.",
      "stats": [
        [
          "Middle half earns",
          "{p25} to {p75}"
        ]
      ],
      "caveats": [
        "Uses the first field listed on the degree, including people with further degrees."
      ]
    }
  },
  {
    "id": "us-language-community",
    "mode": "us",
    "topic": "identity",
    "title": "Language community",
    "question": "How many people speak your language at home?",
