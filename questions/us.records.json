        "type": "select",
        "label": "Language",
        "optionsFrom": {
          "dataset": "us.acs.languages",
          "path": [
            "languages"
          ]
        },
        "default": "1200"
      }
    ],
    "params": {
      "dataset": "us.acs.languages",
      "items": {
        "l": {
          "path": [
            "languages",
            "{language}"
          ]
        }
      },
      "error": "There are no figures for that language yet.",
      "values": {
        "speakers": {
          "field": "l.speakers",
          "format": {
            "type": "compact"
          }
        },
        "language": {
          "field": "l.label"
        }
      },
      "bars": {
        "title": "Where they live",
        "list": "l.states",
        "labels": "@us_states_any",
        "unit": "number"
      }
    },
    "text": {
      "headline": "{speakers}",
      "sentence": "About {speakers} people aged 5 and over speak {language} at home in the US."
    }
  },
  {
    "id": "us-diaspora",
    "mode": "us",
    "topic": "identity",
    "title": "Your diaspora",
    "question": "How many people from your birth country live in the US?",
    "kind": "item_record",
    "datasets": [
      "us.acs.diaspora"
    ],
    "inputs": [
      {
        "key": "country",
        "type": "select",
        "label": "Country of birth",
        "optionsFrom": {
          "dataset": "us.acs.diaspora",
          "path": [
            "countries"
          ]
        },
        "default": "303"
      }
    ],
    "params": {
      "dataset": "us.acs.diaspora",
      "items": {
        "c": {
          "path": [
            "countries",
            "{country}"
          ]
        }
      },
      "error": "There are no figures for that country yet.",
      "values": {
        "people": {
          "field": "c.people",
          "format": {
            "type": "compact"
          }
        },
        "country": {
          "field": "c.label"
        },
        "income": {
          "field": "c.medianIncome",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        }
      },
      "bars": {
        "title": "Where they live",
        "list": "c.states",
        "labels": "@us_states_any",
        "unit": "number"
      }
    },
    "text": {
      "headline": "{people}",
      "sentence": "About {people} people born in {country} live in the US. Their median income is {income}."
    }
  },
  {
    "id": "us-risk-odds",
    "mode": "us",
    "topic": "body",
    "title": "Everyday risk odds",
    "question": "Which of two risks is more likely over a lifetime?",
    "kind": "item_record",
    "datasets": [
      "us.cdc.causes"
    ],
    "inputs": [
      {
        "key": "a",
        "type": "select",
        "label": "First risk",
        "optionsFrom": {
          "dataset": "us.cdc.causes",
          "path": [
            "causes"
          ]
        },
        "default": "car"
      },
      {
        "key": "b",
        "type": "select",
        "label": "Second risk",
        "optionsFrom": {
          "dataset": "us.cdc.causes",
          "path": [
            "causes"
          ]
        },
        "default": "plane"
      }
    ],
    "params": {
      "dataset": "us.cdc.causes",
      "items": {
        "a": {
          "path": [
            "causes",
            "{a}"
          ]
        },
        "b": {
          "path": [
            "causes",
            "{b}"
          ]
        }
      },
      "error": "Pick two risks from the list.",
      "values": {
        "aOdds": {
          "field": "a.oneIn",
          "format": {
            "type": "int"
          }
        },
        "bOdds": {
          "field": "b.oneIn",
          "format": {
            "type": "int"
          }
        },
        "aLabel": {
          "field": "a.label",
          "format": {
            "type": "text",
            "case": "lower"
          }
        },
        "bLabel": {
          "field": "b.label",
          "format": {
            "type": "text",
            "case": "lower"
          }
        },
        "comparison": {
          "ratio": [
            "b.oneIn",
            "a.oneIn"
          ],
          "format": {
            "type": "num",
            "digits": 1
          },
          "atLeast": 1,
          "then": "The first is {value} times as likely",
          "else": "The second is {inverse} times as likely"
        }
      }
    },
    "text": {
      "headline": "1 in {aOdds}",
      "sentence": "The lifetime odds of dying from {aLabel} are 1 in {aOdds}, and from {bLabel} 1 in {bOdds}.",
      "stats": [
        [
          "Comparison",
          "{comparison}"
        ]
      ],
      "caveats": [
        "Lifetime odds for someone born today, from recent death rates."
      ]
    }
  },
  {
    "id": "us-couple-match",
    "mode": "us",
    "topic": "dating",
    "title": "Couple match",
    "question": "How common is a pairing like yours?",
    "kind": "item_record",
    "datasets": [
      "us.acs.couples"
    ],
    "inputs": [
      {
        "key": "sex",
        "type": "choice",
        "label": "You are",
        "options": "@sex",
        "default": "F"
      },
      {
        "key": "edu",
        "type": "select",
        "label": "Your education",
        "options": [
          [
            "0",
            "Less than high school"
          ],
          [
            "1",
            "High school or GED"
          ],
          [
            "2",
            "Some college or associate degree"
          ],
          [
            "3",
            "Bachelor's degree"
          ],
          [
            "4",
            "Graduate or professional degree"
          ]
        ],
        "default": "3"
      },
      {
        "key": "partnerEdu",
        "type": "select",
        "label": "Your partner's education",
        "options": [
          [
            "0",
            "Less than high school"
          ],
          [
            "1",
            "High school or GED"
          ],
          [
            "2",
            "Some college or associate degree"
          ],
          [
            "3",
            "Bachelor's degree"
          ],
          [
            "4",
            "Graduate or professional degree"
          ]
        ],
        "default": "3"
      },
      {
        "key": "race",
        "type": "select",
        "label": "Your race or ethnicity",
        "options": [
          [
            "white",
            "White"
          ],
          [
            "black",
            "Black"
          ],
          [
            "asian",
            "Asian"
          ],
          [
            "hispanic",
            "Hispanic"
          ],
          [
            "other",
            "Other or more than one race"
          ]
        ],
        "default": "white"
      },
      {
        "key": "partnerRace",
        "type": "select",
        "label": "Your partner's race or ethnicity",
        "options": [
          [
            "white",
            "White"
          ],
          [
            "black",
            "Black"
          ],
          [
            "asian",
            "Asian"
          ],
          [
            "hispanic",
            "Hispanic"
          ],
          [
            "other",
            "Other or more than one race"
          ]
        ],
        "default": "white"
      }
    ],
    "params": {
      "dataset": "us.acs.couples",
      "items": {
        "edu": {
          "path": [
            "eduPairs",
            {
              "input": "sex",
              "map": {
                "M": "{edu}|{partnerEdu}"
              },
              "default": "{partnerEdu}|{edu}"
            }
          ],
          "optional": true
        },
        "race": {
          "path": [
            "racePairs",
            {
              "input": "sex",
              "map": {
                "M": "{race}|{partnerRace}"
              },
              "default": "{partnerRace}|{race}"
            }
          ],
          "optional": true
        },
        "earns": {
          "path": [
            "manEarnsMore",
            {
              "input": "sex",
              "map": {
                "M": "{edu}|{partnerEdu}"
              },
              "default": "{partnerEdu}|{edu}"
            }
          ],
          "optional": true
        }
      },
      "values": {
        "share": {
          "field": "edu",
          "orElse": 0,
          "format": {
            "type": "pct"
          }
        },
        "raceShare": {
          "field": "race",
          "orElse": 0,
          "format": {
            "type": "pct"
          }
        },
        "earns": {
          "field": "earns",
          "format": {
            "type": "pct"
          }
        },
        "manEdu": {
          "text": {
            "input": "sex",
            "map": {
              "M": "{edu}"
            },
            "default": "{partnerEdu}"
          },
          "map": {
            "0": "less than high school",
            "1": "a high school diploma or GED",
            "2": "some college or an associate degree",
            "3": "a bachelor's degree",
            "4": "a graduate or professional degree"
          }
        },
        "womanEdu": {
          "text": {
            "input": "sex",
            "map": {
              "M": "{partnerEdu}"
            },
            "default": "{edu}"
          },
          "map": {
            "0": "less than high school",
            "1": "a high school diploma or GED",
            "2": "some college or an associate degree",
            "3": "a bachelor's degree",
            "4": "a graduate or professional degree"
          }
        }
      },
      "grid": {
        "share": "share"
      }
    },
    "text": {
      "headline": "{share}",
      "sentence": "{share} of couples pair a man with {manEdu} and a woman with {womanEdu}, like you two.",
      "stats": [
        [
          "Couples with your race pairing",
          "{raceShare}"
        ],
        [
          "He earns more, in couples like yours",
          "{earns}"
        ]
      ],
      "caveats": [
        "Pairings count opposite-sex couples who live together."
      ]
    }
  },
  {
    "id": "us-family-then-now",
    "mode": "us",
    "topic": "family",
    "title": "Family size then vs now",
    "question": "How big were families when you were born?",
    "kind": "item_record",
    "datasets": [
      "us.nchs.births_history"
    ],
    "inputs": [
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "default": 1990,
        "min": 1920,
        "max": 2026,
        "step": 1
      }
    ],
    "params": {
      "dataset": "us.nchs.births_history",
      "items": {
        "then": {
          "path": [
            "years",
            "{birthYear}"
          ]
        },
        "now": {
          "path": [
            "years"
          ],
          "pick": "maxKey"
        }
      },
      "error": "There are no figures for that year yet.",
      "values": {
        "year": {
          "text": "{birthYear}"
        },
        "latest": {
          "key": "now"
        },
        "thenTfr": {
          "field": "then.tfr",
          "format": {
            "type": "num",
            "digits": 2
          }
        },
        "nowTfr": {
          "field": "now.tfr",
          "format": {
            "type": "num",
            "digits": 2
          }
        },
        "thenBirths": {
          "field": "then.births",
          "format": {
            "type": "compact"
          }
        },
        "nowBirths": {
          "field": "now.births",
          "format": {
            "type": "compact"
          }
        }
      }
    },
    "text": {
      "headline": "{thenTfr} children",
      "sentence": "In {year}, US women were on track to have {thenTfr} children each. In {latest} the figure was {nowTfr}.",
      "stats": [
        [
          "Births in {year}",
          "{thenBirths}"
        ],
        [
          "Births in {latest}",
          "{nowBirths}"
        ]
      ]
    }
  },
  {
    "id": "us-salary-furthest",
    "mode": "us",
    "topic": "home",
    "title": "Where your salary goes furthest",
    "question": "What is your salary worth in other states?",
    "kind": "compare_set",
    "datasets": [
      "us.bea.rpp"
    ],
    "inputs": [
      {
        "key": "salary",
        "type": "money",
        "label": "Your yearly salary",
        "currency": "USD",
        "default": 70000,
        "min": 0,
        "step": 1000
      },
      {
        "key": "home",
        "type": "select",
        "label": "Where you live now",
        "options": "@us_states_any",
        "default": "*"
      }
    ],
    "params": {
      "dataset": "us.bea.rpp",
      "items": {
        "keysOf": [
          "states"
        ]
      },
      "value": {
        "path": [
          "states",
          "{item}"
        ],
        "scale": {
          "by": "salary",
          "base": {
            "input": "home",
            "fixed": {
              "*": 100
            },
            "path": [
              "states",
              "{home}"
            ],
            "error": "There is no price level for that state yet."
          }
        }
      },
      "labels": "@us_states_any",
      "sort": "asc",
      "mark": "home",
      "format": {
        "type": "money",
        "currency": "USD"
      },
      "shown": {
        "salaryText": {
          "input": "salary",
          "format": {
            "type": "money",
            "currency": "USD"
          }
        }
      },
      "phrases": {
        "place": {
          "input": "home",
          "map": {
            "*": "in the US"
          },
          "default": "in {label.home}"
        }
      },
      "bars": {
        "title": "Salary needed for the same standard of living",
        "ends": 5,
        "unit": "money",
        "currency": "USD"
      }
    },
    "text": {
      "headline": "{first}",
      "sentence": "Living as well as you do on {salaryText} {place} would take about {first} in {firstLabel} and {last} in {lastLabel}.",
      "caveats": [
        "Price levels cover goods, services and rents; taxes are not included."
      ]
    }
  },
  {
    "id": "us-personal-inflation",
    "mode": "us",
    "topic": "home",
    "title": "Your personal inflation",
    "question": "How fast are prices rising for what you buy?",
    "kind": "personal_inflation",
    "datasets": [
      "us.bls.cpi"
    ],
    "inputs": [
      {
        "key": "weights",
        "type": "weights",
        "label": "Share of your spending (%)",
        "default": null,
        "weightsFrom": {
          "dataset": "us.bls.cpi",
          "path": [
