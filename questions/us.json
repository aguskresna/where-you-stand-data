    "datasets": [
      "us.acs.commute_q"
    ],
    "inputs": [
      {
        "key": "minutes",
        "type": "number",
        "label": "One-way commute",
        "default": 25,
        "min": 0,
        "max": 180,
        "unit": "minutes"
      },
      {
        "key": "state",
        "type": "select",
        "label": "State",
        "options": "@us_states_any",
        "default": "*"
      }
    ],
    "params": {
      "dataset": "us.acs.commute_q",
      "path": [
        "groups"
      ],
      "value": "minutes",
      "parts": [
        {
          "input": "state",
          "phrase": {
            "*": "in the US",
            "_": "in {label}"
          }
        }
      ],
      "fallbackOrder": [
        0
      ],
      "format": {
        "type": "number",
        "digits": 0,
        "suffix": " minutes"
      }
    },
    "text": {
      "headline": "Longer than {pct}",
      "sentence": "Your commute is longer than {pct} of commutes {group}.",
      "stats": [
        [
          "Median one-way commute",
          "{median}"
        ]
      ],
      "caveats": [
        "Counts people who travel to work; people working from home are left out."
      ]
    }
  },
