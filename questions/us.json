  {
    "id": "us-birthday-rank",
    "mode": "us",
    "topic": "identity",
    "title": "Birthday rank",
    "question": "How common is your birthday?",
    "kind": "date_rank",
    "datasets": [
      "us.births.daily"
    ],
    "inputs": [
      {
        "key": "birthday",
        "type": "monthday",
        "label": "Your birthday",
        "default": {
          "month": 6,
          "day": 15
        }
      }
    ],
    "params": {
      "dataset": "us.births.daily",
      "input": "birthday",
      "place": "in the US"
    },
    "text": {
      "headline": "{rank} of {of}",
      "sentence": "About {births} babies were born {place} on {date} in an average year, against {mean} on a typical day.",
      "stats": [
        [
          "Most common birthday",
          "{top}"
        ],
        [
          "Least common birthday",
          "{bottom}"
        ],
        [
          "Years counted",
          "{first} to {last}"
        ]
      ]
    }
  },
  {
    "id": "us-time-left",
    "mode": "us",
    "topic": "body",
    "title": "Time left",
    "question": "How many years does the average person your age have ahead?",
    "kind": "life_table",
    "datasets": [
      "us.nchs.lifetable"
    ],
    "inputs": [
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "default": 30,
        "min": 0,
        "max": 100,
        "unit": "years"
      },
      {
        "key": "sex",
        "type": "choice",
        "label": "Sex",
        "options": "@sex",
        "default": "F"
      }
    ],
    "params": {
      "dataset": "us.nchs.lifetable",
      "table": [
        "tables",
        "{sex}"
      ],
      "fallback": [
        "tables",
        "B"
      ],
      "age": "age",
      "who": {
        "input": "sex",
        "map": {
          "F": "women",
          "M": "men"
        },
        "default": "people"
      },
      "place": "in the US"
    },
    "text": {
      "headline": "About {left} more years",
      "sentence": "On today's death rates, {who} aged {age} {place} live to about {liveTo} on average.",
      "caveats": [
        "A period life table: it assumes today’s death rates at every age, so most people your age will do somewhat better."
      ]
    }
  },
  {
    "id": "us-age-rank",
    "mode": "us",
    "topic": "identity",
    "title": "Age rank",
    "question": "How many Americans are older than you?",
    "kind": "age_rank",
    "datasets": [
      "us.census.pop_age"
    ],
    "inputs": [
      {
        "key": "birthDate",
        "type": "date",
        "label": "Birth date",
        "default": "1995-06-15",
        "min": "1900-01-01"
      }
    ],
    "params": {
      "dataset": "us.census.pop_age",
      "layout": "single",
      "path": [
        "total"
      ],
      "birthDate": "birthDate",
      "place": "in the US"
    },
    "text": {
      "headline": "Older than {younger}",
      "sentence": "You're older than {younger} of the people living {place}, and younger than {older}."
    }
  }
]