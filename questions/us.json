[
  {
    "id": "us-income-rank",
    "mode": "us",
    "topic": "money",
    "title": "Income rank",
    "question": "Where does your income rank?",
    "kind": "group_rank",
    "datasets": [
      "us.acs.income_q"
    ],
    "inputs": [
      {
        "key": "income",
        "type": "money",
        "label": "Your yearly income",
        "currency": "USD",
        "default": 60000,
        "min": 0,
        "step": 1000
      },
      {
        "key": "sex",
        "type": "choice",
        "label": "Sex",
        "options": "@sex",
        "default": "F"
      },
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "default": 30,
        "min": 18,
        "max": 100,
        "unit": "years"
      },
      {
        "key": "state",
        "type": "select",
        "label": "State",
        "options": "@us_states_any",
        "default": "*"
      }
    ],
    "params": {
      "dataset": "us.acs.income_q",
      "path": [
        "groups"
      ],
      "value": "income",
      "parts": [
        {
          "input": "sex",
          "phrase": {
            "F": "women",
            "M": "men",
            "*": "adults"
          }
        },
        {
          "input": "age",
          "bands": "@AGE",
          "phrase": {
            "*": "",
            "_": "aged {band}"
          }
        },
        {
          "input": "state",
          "phrase": {
            "*": "in the US",
            "_": "in {label}"
          }
        }
      ],
      "fallbackOrder": [
        2,
        1,
        0
      ],
      "format": {
        "type": "money",
        "currency": "USD"
      }
    },
    "text": {
      "headline": "{rank}",
      "sentence": "You earn more than {pct} of {group}.",
      "stats": [
        [
          "Median for this group",
          "{median}"
        ]
      ],
      "caveats": [
        "Counts adults with any income in the past 12 months, before tax."
      ]
    }
  },
  {
    "id": "us-height-rank",
    "mode": "us",
    "topic": "body",
    "title": "Height rank",
    "question": "How tall are you compared with people like you?",
    "kind": "group_rank",
    "datasets": [
      "us.nhanes.body"
    ],
    "inputs": [
      {
        "key": "sex",
        "type": "choice",
        "label": "Sex",
        "options": "@sex",
        "default": "F"
      },
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "default": 30,
        "min": 18,
        "max": 100,
        "unit": "years"
      },
      {
        "key": "height",
        "type": "height",
        "label": "Your height",
        "default": 170
      }
    ],
    "params": {
      "dataset": "us.nhanes.body",
      "path": [
        "measures",
        "height_cm",
        "groups"
      ],
      "value": "height",
      "parts": [
        {
          "input": "sex",
          "phrase": {
            "F": "women",
            "M": "men",
            "*": "adults"
          }
        },
        {
          "input": "age",
          "bands": "@AGE",
          "phrase": {
            "*": "",
            "_": "aged {band}"
          }
        }
      ],
      "fallbackOrder": [
        1,
        0
      ],
      "suffix": "in the US",
      "format": {
        "type": "height"
      }
    },
    "text": {
      "headline": "{rank}",
      "sentence": "You're taller than {pct} of {group}.",
      "stats": [
        [
          "Average height for this group",
          "{median}"
        ]
      ]
    }
  },
  {
    "id": "us-commute-rank",
