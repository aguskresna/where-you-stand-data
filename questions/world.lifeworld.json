        "label": "Country",
        "default": "USA",
        "optionsFrom": {
          "dataset": "world.oecd.time_use",
          "path": [
            "countries"
          ]
        }
      },
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "default": 30,
        "min": 18,
        "max": 100,
        "unit": "years"
      },
      {
        "key": "sex",
        "type": "choice",
        "label": "Sex",
        "options": "@sex",
        "default": "F"
      },
      {
        "key": "sleep",
        "type": "number",
        "label": "Sleep, hours a day",
        "default": 8,
        "min": 0,
        "max": 24,
        "step": 0.5
      },
      {
        "key": "paidWork",
        "type": "number",
        "label": "Paid work or study, hours a day (average over the week)",
        "default": 5,
        "min": 0,
        "max": 24,
        "step": 0.5
      },
      {
        "key": "unpaidWork",
        "type": "number",
        "label": "Housework and care, hours a day",
        "default": 2,
        "min": 0,
        "max": 24,
        "step": 0.5
      },
      {
        "key": "leisure",
        "type": "number",
        "label": "Leisure, hours a day",
        "default": 4,
        "min": 0,
        "max": 24,
        "step": 0.5
      }
    ],
    "params": {
      "dataset": "world.wpp.lifetable",
