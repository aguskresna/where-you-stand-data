    "datasets": [
      "world.pip.percentiles",
      "world.wdi",
      "world.wpp.pop_age",
      "world.wpp.indicators"
    ],
    "inputs": [
      {
        "key": "country",
        "type": "select",
        "label": "Where you live",
        "default": "USA",
        "optionsFrom": {
          "dataset": "world.wpp.indicators",
          "path": [
            "countries"
          ],
          "exclude": [
            "WLD"
          ],
          "onlyWith": {
            "dataset": "world.wdi",
            "path": [
              "indicators",
              "PA.NUS.PRVT.PP",
              "series"
            ]
          }
        }
      },
      {
        "key": "income",
        "type": "money",
        "label": "Household income per year",
        "currency": "USD",
        "default": 60000,
        "min": 0,
        "step": 100,
        "currencyFrom": "country"
      },
      {
        "key": "size",
        "type": "number",
        "label": "People in your household",
        "default": 1,
        "min": 1,
        "max": 20
      },
      {
        "key": "birthDate",
        "type": "date",
        "label": "Birth date",
        "default": "1995-06-15",
        "min": "1900-01-01"
      }
    ],
    "params": {
      "pip": "world.pip.percentiles",
      "wdi": "world.wdi",
      "wpp": "world.wpp.indicators",
      "country": "country",
      "income": "income",
      "size": "size",
      "ppp": "PA.NUS.PRVT.PP",
      "cpi": "FP.CPI.TOTL",
      "baseYear": 2021,
      "line": 3,
      "noPpp": "There's no purchasing-power rate for {name} yet.",
      "cpiNote": "Your income is taken back to 2021 prices using consumer prices up to {cpiYear}.",
      "noCpiNote": "There is no consumer price series for this country, so your income is treated as if earned at 2021 prices.",
      "ages": {
        "dataset": "world.wpp.pop_age",
        "path": [
          "groups",
          "WLD"
        ],
        "birthDate": "birthDate",
        "missing": "There are no world population figures yet."
      },
      "online": "IT.NET.USER.ZS",
      "sentenceParts": [
        "{richer} would live on less than you",
        "{younger} would be younger than you",
        {
          "text": "{online} would use the internet",
          "when": "online"
        }
      ],
      "bars": {
        "title": "Of 100 people",
        "unit": "share",
        "items": [
          {
            "label": "Live on less than you",
            "value": "richer"
          },
          {
            "label": "Are younger than you",
            "value": "younger"
          },
          {
            "label": "Use the internet ({onlineYear})",
            "value": "online",
            "when": "online"
          }
        ]
      },
      "gridCaption": "The shaded figures live on less than you."
    },
    "text": {
      "headline": "{richer} live on less",
      "sentence": "If the world were 100 people, {parts}.",
      "caveats": [
        "Income compares household income or spending per person at 2021 purchasing-power rates."
      ]
    }
  },
  {
    "id": "world-your-generation",
    "mode": "world",
    "topic": "identity",
    "title": "Your generation",
    "question": "How many people born the same year as you are alive today?",
    "kind": "cohort_size",
    "datasets": [
      "world.wpp.pop_age",
      "world.wpp.indicators"
    ],
    "inputs": [
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "default": 1990,
        "min": 1920,
        "max": 2026
      },
      {
        "key": "place",
        "type": "select",
        "label": "Compare with",
        "default": "WLD",
        "optionsFrom": {
          "dataset": "world.wpp.indicators",
          "path": [
            "countries"
          ],
          "exclude": [
            "WLD"
          ],
          "first": [
            [
              "WLD",
              "The whole world"
            ]
          ]
        }
      }
    ],
    "params": {
      "dataset": "world.wpp.pop_age",
      "path": [
        "groups",
        "{place}"
      ],
      "layout": "single_mf",
      "method": "bornIn",
      "yearPath": [
        "year"
      ],
      "scale": 1000,
      "birthYear": "birthYear",
      "missing": "There are no population figures for {label.place} yet.",
      "rangeError": "Pick a birth year between {from} and {to}.",
      "births": {
        "dataset": "world.wpp.indicators",
        "series": "births",
        "country": "{place}",
        "year": "{year}",
        "scale": 1000
      },
      "place": {
        "input": "place",
        "map": {
          "WLD": "in the world"
        },
        "default": "in {label.place}"
      },
      "birthsLine": " {births} babies were born there that year.",
      "gridCaption": {
        "input": "place",
        "map": {
          "WLD": "Of 100 babies born that year, the shaded figures are alive today."
        },
        "default": ""
      },
      "stats": [
        {
          "stat": [
            {
              "input": "place",
              "map": {
                "WLD": "Still alive, of everyone born that year"
              },
              "default": ""
            },
            "{aliveShare}"
          ],
          "when": "births"
        }
      ],
      "caveats": [
        {
          "input": "place",
          "map": {
            "WLD": ""
          },
          "default": "Counts everyone living there today, including people who moved there, and leaves out those who left."
        }
      ],
      "projection": {
        "after": 2023,
        "caveat": "Figures after 2023 are UN projections."
      }
    },
    "text": {
      "headline": "{alive}",
      "sentence": "About {alive} people born in {year} are alive {place} today.{birthsLine}"
    }
  },
  {
    "id": "world-pop-when-born",
    "mode": "world",
    "topic": "people",
    "title": "World population when you were born",
    "question": "How many people were there when you were born?",
    "kind": "wpp_series",
    "datasets": [
      "world.wpp.indicators"
    ],
    "inputs": [
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "default": 1990,
        "min": 1950,
        "max": 2026
      },
      {
        "key": "place",
        "type": "select",
        "label": "Show",
        "default": "WLD",
        "optionsFrom": {
          "dataset": "world.wpp.indicators",
          "path": [
            "countries"
          ],
          "exclude": [
            "WLD"
          ],
          "first": [
            [
              "WLD",
              "The whole world"
            ]
          ]
        }
      }
    ],
    "params": {
      "dataset": "world.wpp.indicators",
      "name": {
        "input": "place",
        "map": {
          "WLD": "the world"
        },
        "default": "{label.place}"
      },
      "points": {
        "then": {
          "series": "pop",
          "country": "{place}",
          "year": "{v.birthYear}",
          "scale": 1000,
          "format": "compact",
          "required": "There are no population figures for that year."
        },
        "today": {
          "series": "pop",
          "country": "{place}",
          "year": "{thisYear}",
          "scale": 1000,
          "format": "compact",
          "required": "There are no population figures for this year."
        }
      },
      "sums": {
        "since": {
          "series": "births",
          "country": "{place}",
          "from": "{v.birthYear}",
          "to": "{thisYear}",
          "scale": 1000,
          "format": "compact"
        }
      },
      "ratios": {
        "ratio": {
          "of": "today",
          "to": "then",
          "format": "num",
          "digits": 1
        }
      },
      "projection": {
        "after": 2023,
        "caveat": "Figures after 2023 are UN projections."
      }
    },
    "text": {
      "headline": "{then}",
      "sentence": "When you were born in {v.birthYear}, {name} had {then} people. In {thisYear} it has about {today}, {ratio} times as many.",
      "stats": [
        [
          "Babies born there since {v.birthYear}",
          "{since}"
        ]
      ]
    }
  },
  {
    "id": "world-family-size",
    "mode": "world",
    "topic": "family",
    "title": "Family size vs your country",
    "question": "How does your family size compare with your country’s?",
    "kind": "wpp_series",
    "datasets": [
      "world.wpp.indicators"
    ],
    "inputs": [
      {
        "key": "kids",
        "type": "number",
        "label": "Your children",
        "default": 2,
        "min": 0,
        "max": 20
      },
      {
        "key": "country",
        "type": "select",
        "label": "Country",
        "default": "USA",
        "optionsFrom": {
          "dataset": "world.wpp.indicators",
          "path": [
            "countries"
          ],
          "exclude": [
            "WLD"
          ]
        }
      }
    ],
    "params": {
      "dataset": "world.wpp.indicators",
      "points": {
        "tfr": {
          "series": "tfr",
          "country": "{country}",
          "year": "{thisYear}",
          "format": "num",
          "digits": 1,
          "required": "There are no birth figures for {label.country} yet."
        },
        "world": {
          "series": "tfr",
          "country": "WLD",
          "year": "{thisYear}",
          "format": "num",
          "digits": 1
        }
      },
      "compare": {
        "input": "kids",
        "with": "tfr",
        "tolerance": 0.05,
        "digits": 1,
        "same": "Right on average",
        "more": "{diff} above average",
        "less": "{diff} below average"
      },
      "extremes": {
        "series": "tfr",
        "year": "{thisYear}",
        "digits": 1
      },
      "stats": [
        {
          "stat": [
            "Highest",
            "{highest}, {highestValue}"
          ],
          "when": "extremes"
        },
        {
          "stat": [
            "Lowest",
            "{lowest}, {lowestValue}"
          ],
          "when": "extremes"
        }
      ],
      "projection": {
        "after": 2023,
        "caveat": "Figures after 2023 are UN projections."
      }
    },
    "text": {
      "headline": "{compare}",
      "sentence": "On today's birth rates, women in {label.country} are on track to have {tfr} children each. You have {v.kids}.",
      "stats": [
        [
          "Whole world",
          "{world} children per woman"
        ]
      ],
      "caveats": [
        "Births per woman is the total fertility rate: the children a woman would have over her life at this year’s birth rates."
      ]
    }
  },
