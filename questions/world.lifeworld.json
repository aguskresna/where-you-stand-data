[
  {
    "id": "world-income-rank",
    "mode": "world",
    "topic": "money",
    "title": "Global income rank",
    "question": "Where does your income rank among everyone in the world?",
    "kind": "global_income",
    "datasets": [
      "world.pip.percentiles",
      "world.wdi",
      "world.wpp.indicators"
    ],
    "inputs": [
      {
        "key": "country",
        "type": "select",
        "label": "Where you live",
        "default": "USA",
        "optionsFrom": {
          "dataset": "world.wpp.indicators",
          "path": [
            "countries"
          ],
          "exclude": [
            "WLD"
          ],
          "onlyWith": {
            "dataset": "world.wdi",
            "path": [
              "indicators",
              "PA.NUS.PRVT.PP",
              "series"
            ]
          }
        }
      },
      {
        "key": "income",
        "type": "money",
        "label": "Household income per year",
        "currency": "USD",
        "default": 60000,
        "min": 0,
        "step": 100,
        "currencyFrom": "country"
      },
      {
        "key": "size",
        "type": "number",
        "label": "People in your household",
        "default": 1,
        "min": 1,
        "max": 20
      }
    ],
    "params": {
      "pip": "world.pip.percentiles",
      "wdi": "world.wdi",
      "wpp": "world.wpp.indicators",
      "country": "country",
      "income": "income",
      "size": "size",
      "ppp": "PA.NUS.PRVT.PP",
      "cpi": "FP.CPI.TOTL",
      "baseYear": 2021,
      "line": 3,
      "noPpp": "There's no purchasing-power rate for {name} yet.",
      "cpiNote": "Your income is taken back to 2021 prices using consumer prices up to {cpiYear}.",
      "noCpiNote": "There is no consumer price series for this country, so your income is treated as if earned at 2021 prices.",
      "stats": [
        {
          "stat": [
            "Your rank in {name}",
            "{ownRank}"
          ],
          "when": "own"
        },
        [
          "World median",
          "{median} a day"
        ],
        [
          "Living on under $3 a day, the extreme poverty line",
          "{under}"
        ]
      ]
    },
    "text": {
      "headline": "{rank}",
      "sentence": "Your household's income comes to about {perDay} per person a day at 2021 US prices, more than {pct}% of the world's people live on.",
      "caveats": [
        "Each country's figures come from its latest household survey; some measure spending, which runs lower than income."
      ]
    }
  },
  {
    "id": "world-100-people",
    "mode": "world",
    "topic": "people",
    "title": "If the world were 100 people",
