      "fallback": [
        "tables",
        "B"
      ],
      "age": "age",
      "place": {
        "dataset": "world.oecd.time_use",
        "path": [
          "countries",
          "{country}"
        ],
        "nameField": "name",
        "missing": "There are no time-use figures for that country."
      },
      "noTable": "There's no life table for {name} yet.",
      "activities": [
        {
          "key": "sleep",
          "label": "Sleep"
        },
        {
          "key": "paidWork",
          "label": "Paid work or study"
        },
        {
          "key": "unpaidWork",
          "label": "Housework and care"
        },
        {
          "key": "leisure",
          "label": "Leisure"
        }
      ],
      "rest": "Everything else",
      "averages": {
        "dataset": "world.oecd.time_use",
