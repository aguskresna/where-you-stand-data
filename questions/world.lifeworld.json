  {
    "id": "world-dream-partner",
    "mode": "world",
    "topic": "dating",
    "title": "Global dream partner (age and income)",
    "question": "How many people worldwide fit your age and income standards?",
    "kind": "world_partner",
    "datasets": [
      "world.wpp.pop_age",
      "world.pip.percentiles",
      "world.wdi",
      "world.wpp.indicators"
    ],
    "inputs": [
      {
        "key": "seeking",
        "type": "choice",
        "label": "Looking for",
        "options": [
          [
            "M",
            "Men"
          ],
          [
            "F",
            "Women"
          ]
        ],
        "default": "M"
      },
      {
        "key": "ages",
        "type": "range",
        "label": "Age range",
        "min": 18,
        "max": 80,
        "step": 1,
        "default": [
          25,
          35
        ]
