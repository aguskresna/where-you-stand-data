  {
    "id": "my-personal-inflation",
    "mode": "my",
    "topic": "home",
    "title": "Your personal inflation",
    "question": "How fast are prices rising for what you buy?",
    "kind": "personal_inflation",
    "datasets": [
      "my.cpi"
    ],
    "inputs": [
      {
        "key": "weights",
        "type": "weights",
        "label": "Share of your spending (%)",
        "default": null,
        "weightsFrom": {
          "dataset": "my.cpi",
          "path": [
            "groups"
          ],
          "labelField": "label",
          "weightField": "weight"
        }
      }
    ],
    "params": {
      "dataset": "my.cpi",
      "weights": "weights",
      "place": "Malaysian",
      "barsTitle": "Price change by category",
      "noWeights": "Enter how much of your spending goes to at least one category."
    },
    "text": {
      "headline": "{personal}",
      "sentence": "Prices for what you buy rose about {personalPct} over the 12 months to {month}, against {overall} for the official {place} rate.",
      "stats": [
        [
          "Difference from the official rate",
          "{diff} points"
        ]
      ],
      "caveats": [
        "Your weights are scaled to add up to 100%."
      ]
    }
  }
]
