[
  {
    "id": "us-singles-near-you",
    "mode": "us",
    "topic": "dating",
    "title": "Singles near you",
    "question": "How many single people fit your age range where you live?",
    "kind": "count_in_range",
    "datasets": [
      "us.acs.singles"
    ],
    "inputs": [
      {
        "key": "seeking",
        "type": "choice",
        "label": "Looking for",
        "options": [
          [
            "M",
            "Men"
          ],
          [
            "F",
            "Women"
          ]
        ],
        "default": "M"
      },
      {
        "key": "ages",
        "type": "range",
        "label": "Age range",
        "min": 18,
        "max": 80,
        "step": 1,
        "default": [
          25,
          35
        ]
      },
      {
        "key": "state",
        "type": "select",
        "label": "State",
        "options": "@us_states_any",
        "default": "*"
      }
    ],
    "params": {
      "dataset": "us.acs.singles",
      "path": [
        "groups"
      ],
      "agesPath": [
        "ages"
      ],
      "range": "ages",
      "countField": "single",
      "totalField": "all",
      "parts": [
        {
          "input": "seeking",
          "phrase": {
            "F": "women",
            "M": "men"
          }
        },
        {
          "input": "state",
          "phrase": {
            "*": "in the US",
            "_": "in {label}"
          }
        }
      ],
      "fallbackOrder": [
        1
      ],
      "fallbackCaveat": "There are too few survey records for some of those ages in {label.state}, so this uses the whole US.",
      "missing": "There are no figures for that group yet.",
      "empty": "No one matches that age range and place."
    },
    "text": {
      "headline": "{count}",
      "sentence": "About {count} single {seeking} aged {lo}–{hi} live {state}, {share} of everyone that age there.",
      "caveats": [
        "Single means never married, divorced, separated or widowed; some of them have partners."
      ]
    }
  },
  {
    "id": "us-age-gap",
    "mode": "us",
    "topic": "dating",
    "title": "Is our age gap normal?",
    "question": "How common is an age gap like yours?",
    "kind": "group_rank",
    "datasets": [
      "us.acs.couples"
    ],
    "inputs": [
      {
        "key": "you",
        "type": "number",
        "label": "Your age",
        "default": 30,
        "min": 18,
        "max": 100,
        "step": 1,
        "unit": "years"
      },
      {
        "key": "partner",
        "type": "number",
        "label": "Your partner's age",
        "default": 33,
        "min": 18,
        "max": 100,
        "step": 1,
        "unit": "years"
      }
    ],
    "params": {
      "dataset": "us.acs.couples",
      "path": [
        "gap"
      ],
      "valueExpr": "abs(you - partner)",
      "valueFormat": {
        "type": "number",
        "digits": 0
      },
      "format": {
        "type": "number",
        "digits": 0,
        "suffix": " years"
      },
      "fields": {
        "manOlder": {
          "path": [
            "manOlder"
          ],
          "format": {
            "type": "percent"
          }
        },
        "womanOlder": {
          "path": [
            "womanOlder"
          ],
          "format": {
            "type": "percent"
          }
        },
        "sameAge": {
          "path": [
            "sameAge"
          ],
          "format": {
            "type": "percent"
          }
        }
      },
      "whenZero": {
        "headline": "Same age",
        "sentence": "{sameAge} of couples living together are the same age."
      }
    },
    "text": {
      "headline": "{value}-year gap",
      "sentence": "{pctAbove} of couples living together have an age gap this big or bigger.",
      "stats": [
        [
          "He is older",
          "{manOlder}"
        ],
        [
          "She is older",
          "{womanOlder}"
        ],
        [
          "Same age",
          "{sameAge}"
        ]
      ]
    }
  },
  {
    "id": "us-marriage-timing",
    "mode": "us",
    "topic": "dating",
    "title": "Marriage timing",
    "question": "How many people your age have married?",
    "kind": "group_share",
    "datasets": [
      "us.acs.ever_married"
    ],
    "inputs": [
      {
        "key": "sex",
        "type": "choice",
        "label": "Sex",
        "options": "@sex",
        "default": "F"
      },
      {
        "key": "age",
        "type": "number",
        "label": "Age",
        "default": 30,
        "min": 18,
        "max": 80,
        "unit": "years"
      },
      {
        "key": "state",
        "type": "select",
        "label": "State",
        "options": "@us_states_any",
        "default": "*"
      }
    ],
    "params": {
      "dataset": "us.acs.ever_married",
      "parts": [
        {
          "input": "sex",
          "phrase": {
            "F": "women",
            "M": "men",
            "*": "adults"
          }
        },
        {
          "input": "age",
          "round": true,
          "clamp": [
            18,
            80
          ]
        },
        {
          "input": "age",
          "name": "band",
          "round": true,
          "clamp": [
            18,
            80
          ],
          "bands": "@AGE"
        },
        {
          "input": "state",
          "phrase": {
            "*": "in the US",
            "_": "in {label}"
          }
        }
      ],
      "lookups": [
        {
          "path": [
            "byBandState"
          ],
          "key": [
            "sex",
            "band",
            "state"
          ],
          "fallbackOrder": [
            2
          ],
          "exact": true,
          "skipIf": {
            "state": "*"
          },
          "missCaveat": "Too few records for {label.state}, so this uses the whole US."
        },
        {
          "path": [
            "byAge"
          ],
          "key": [
            "sex",
            "age"
          ],
          "fallbackOrder": []
        }
      ],
      "crossing": {
        "path": [
          "byAge"
        ],
        "key": [
          "sex",
          "#"
        ],
        "from": 18,
        "to": 80,
        "at": 0.5,
        "name": "half",
        "found": "age {age}",
        "none": "not by 80"
      },
      "missing": "There are no figures for that age yet."
    },
    "text": {
      "headline": "{share}",
      "sentence": "{share} of {sex} aged {age} {state} have been married at least once.",
      "stats": [
        [
          "Half have married by",
          "{half}"
        ]
      ],
      "caveats": [
        "The age by which half have married is read across today’s age groups, not followed through one generation."
      ]
    }
  },
  {
    "id": "us-will-it-last",
    "mode": "us",
    "topic": "dating",
    "title": "Will it last?",
    "question": "How many first marriages like yours stay together?",
    "kind": "group_share",
    "datasets": [
      "us.nsfg.marriage"
    ],
    "inputs": [
      {
        "key": "ageAtMarriage",
        "type": "number",
        "label": "Age when you married",
        "default": 27,
        "min": 16,
        "max": 70,
        "step": 1,
        "unit": "years"
      },
      {
        "key": "edu",
        "type": "select",
        "label": "Your education",
        "options": [
          [
            "0",
            "Less than high school"
          ],
          [
            "1",
            "High school or GED"
          ],
          [
            "2",
            "Some college or associate degree"
          ],
          [
            "3",
            "Bachelor's degree"
          ],
          [
            "4",
            "Graduate or professional degree"
          ]
        ],
        "default": "3"
      }
    ],
    "params": {
      "dataset": "us.nsfg.marriage",
      "path": [
        "groups"
      ],
      "parts": [
        {
          "input": "ageAtMarriage",
          "bands": [
            "<20",
            "20-24",
            "25-29",
            "30+"
          ]
        },
        {
          "input": "edu"
        }
      ],
      "fallbackOrder": [
        1,
        0
      ],
      "field": "y10",
      "fields": {
        "y20": {
          "key": "y20",
          "format": {
            "type": "percent"
          }
        }
      },
      "fallbackCaveat": "Too few couples match exactly, so this uses a broader group.",
      "missing": "There are no figures for that group yet."
    },
    "text": {
      "headline": "{share}",
      "sentence": "{share} of first marriages like yours are still together after 10 years.",
      "stats": [
        [
          "Still together after 20 years",
          "{y20}"
        ]
      ],
      "caveats": [
        "The survey interviews people aged 15 to 49, so 20-year figures are missing (–) where too few marriages could be followed that long."
      ]
    }
  },
  {
    "id": "us-middle-class",
    "mode": "us",
    "topic": "money",
    "title": "Am I middle class?",
    "question": "Which income tier is your household in?",
    "kind": "rank_tiers",
    "datasets": [
      "us.acs.hh_income"
    ],
    "inputs": [
      {
        "key": "income",
        "type": "money",
        "label": "Household income per year",
        "currency": "USD",
        "default": 90000,
        "min": 0,
        "step": 1000
      },
      {
        "key": "size",
        "type": "number",
        "label": "People in your household",
        "default": 3,
        "min": 1,
        "max": 12,
        "step": 1
      },
      {
        "key": "state",
        "type": "select",
        "label": "State",
        "options": "@us_states_any",
        "default": "*"
      }
    ],
    "params": {
      "dataset": "us.acs.hh_income",
      "mode": "ratio",
      "value": "income",
      "scale": "sqrt(3 / size)",
      "medianPath": [
        "median_adj3"
      ],
      "path": [
        "groups"
      ],
      "parts": [
        {
          "input": "state",
          "phrase": {
            "*": "in the US",
            "_": "in {label}"
          }
        }
      ],
      "fallbackOrder": [
        0
      ],
      "fallbackCaveat": "",
      "missing": "There are no figures for that state yet.",
      "format": {
        "type": "money",
        "currency": "USD"
      },
      "tiers": [
        {
          "name": "Lower income",
          "below": "2/3"
        },
        {
          "name": "Middle income",
          "upTo": 2
        },
        {
          "name": "Upper income"
        }
      ]
    },
    "text": {
      "headline": "{tier}",
      "sentence": "For a household of {n.size}, middle income runs from {cut1} to {cut2} a year. You're at {ratio} times the national median.",
      "stats": [
        [
          "Your rank {group}",
          "{rank}"
        ]
      ],
      "caveats": [
        "Uses the common rule of two-thirds to double the median household income, adjusted for household size."
      ]
    }
  },
